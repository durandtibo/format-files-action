# Ship only what the action needs at runtime (action.yml, LICENSE, Makefile and .make/, which the
# action runs with `make --file="$ACTION_PATH/Makefile" format`). Everything else is excluded from
# `git archive`. When the action starts using a new file, un-ignore it here.
# Do not export-ignore /Makefile or /.make/: the action breaks without them.
/.github/ export-ignore
/review/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.yaml export-ignore
/CLAUDE.md export-ignore
/CODEOWNERS export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/README.md export-ignore
/SECURITY.md export-ignore
